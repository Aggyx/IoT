# Configuración del nodo Control Plane (Servidor k3s)
# Variables de entorno y parámetros para la instalación del servidor k3s

# IP del nodo servidor en la red privada
SERVER_NODE_IP=192.168.56.110

# Puerto de escucha del API server
K3S_API_PORT=6443

# Interfaz de red para Flannel (detectada automáticamente por el script)
# FLANNEL_IFACE=enp0s8 (se detecta dinámicamente)

# Ruta de almacenamiento del token de unión
K3S_TOKEN_PATH=/var/lib/rancher/k3s/server/node-token

# Carpeta compartida para el token (synced folder de Vagrant)
TOKEN_SYNC_PATH=/tokens

# Memoria RAM asignada (en MB)
VM_MEMORY=1024

# Número de CPUs asignadas
VM_CPUS=1

# Modo de escritura del kubeconfig (permitir lectura sin sudo)
KUBECONFIG_MODE=644
