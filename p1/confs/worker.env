# Configuración del nodo Worker k3s
# Variables de entorno y parámetros para la instalación del agente k3s

# IP del nodo worker en la red privada
WORKER_NODE_IP=192.168.56.111

# IP del servidor k3s (control plane)
K3S_SERVER_IP=192.168.56.110

# Puerto del API server del servidor k3s
K3S_SERVER_PORT=6443

# Interfaz de red para Flannel (detectada automáticamente por el script)
# FLANNEL_IFACE=enp0s8 (se detecta dinámicamente)

# Ruta del token de unión (sincronizado desde servidor)
K3S_TOKEN_PATH=/tokens/node-token

# Memoria RAM asignada (en MB)
VM_MEMORY=512

# Número de CPUs asignadas
VM_CPUS=1

# Timeout para esperar el token del servidor (en segundos)
TOKEN_WAIT_TIMEOUT=180

# Timeout para registración del nodo (en segundos)
NODE_REGISTRATION_TIMEOUT=120
