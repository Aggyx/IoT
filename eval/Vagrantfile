# Evaluation VM for Inception-of-Things.
#
# The whole project runs inside this VM:
#   - p1 / p2 : Vagrant + VirtualBox inside the VM (nested virtualization)
#   - p3 / bonus : Docker, kubectl and k3d are NOT preinstalled here, on purpose:
#                  p3/scripts/install.sh installs them during the defense.
# An XFCE desktop with Firefox gives a browser for the p2 apps, Argo CD and GitLab.
#
# Usage (from this folder):  vagrant up
# Keyboard layout of the desktop:  IOT_KEYBOARD=fr vagrant up   (default: us)

KEYBOARD_LAYOUT = ENV.fetch("IOT_KEYBOARD", "us")

Vagrant.configure("2") do |config|
  config.vm.box         = "bento/debian-13"
  config.vm.box_version = "202510.26.0"
  config.vm.hostname    = "iot-eval"

  # Copy the repository into the VM at `vagrant up` (one-way; `vagrant rsync` to refresh).
  # Not vboxsf: the nested Vagrant must chmod its SSH keys, which vboxsf does not allow.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "..", "/home/vagrant/IoT",
    type: "rsync",
    rsync__exclude: [".vagrant/", ".tokens/", "*.pdf"]

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "iot-eval"
    vb.gui    = true
    vb.memory = 16384   # GitLab alone wants ~4-6 GiB; p1/p2 VMs need up to 2 GiB
    vb.cpus   = 8       # half of the host's 16 threads
    vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
    vb.customize ["modifyvm", :id, "--vram", "128"]
    vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
  end

  # Stage 1: desktop, kernel headers, KVM disabled, then reboot on the up-to-date kernel.
  config.vm.provision "system", type: "shell",
    path: "provision.sh", args: ["system", KEYBOARD_LAYOUT], reboot: true

  # Stage 2: VirtualBox + Vagrant, kernel modules built against the running kernel.
  config.vm.provision "virtualization", type: "shell",
    path: "provision.sh", args: ["virtualization"]
end
